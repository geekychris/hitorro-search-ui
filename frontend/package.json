{
  "name": "@hitorro/search-ui",
  "private": true,
  "version": "3.0.1",
  "description": "hitorro-search-ui — React library + reference SPA, built as a pnpm workspace.",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter demo-app dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules"
  }
}
