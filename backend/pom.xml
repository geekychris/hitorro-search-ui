            <artifactId>spring-boot-starter-webclient</artifactId>
            <!-- WebClient (spring-webflux + Reactor Netty) for outbound calls to
                 fleet-retrieval; we keep the servlet stack (starter-webmvc) for
                 the primary REST surface. Boot 4 moved the WebClient.Builder
                 auto-configuration out of the WebFlux starter into this one. -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
